# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SOCKET_MODE=true
SLACK_PORT=3000

# Ngrok URL (update this when running ngrok)
NGROK_URL=your_ngrok_url_here

# Database Configuration (PostgreSQL / AWS RDS)
DATABASE_URL=postgresql://postgres:caleo@localhost:5432/caleo

# Microsoft OAuth (for Outlook calendar)
MICROSOFT_APP_ID=your_app_id_here
MICROSOFT_APP_PASSWORD=your_app_password_here

# Google OAuth (for Google Calendar)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Encryption Key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your_encryption_key_here

# Agent Configuration
USE_REMOTE_AGENT=false
AGENT_ENDPOINT=

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
BILLING_BASE_URL=https://your-domain.com

# Environment
NODE_ENV=development
