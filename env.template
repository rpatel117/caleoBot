# ============================================================
# Caleo Bot — Environment Variables
# Copy to config.env and fill in values: cp env.template config.env
# ============================================================

# --- Anthropic (AI Agent) ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Slack App ---
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=your-slack-app-token
SLACK_SOCKET_MODE=true
SLACK_PORT=3000

# --- Database (PostgreSQL) ---
# Local:      postgres://postgres:password@localhost:5432/caleo
# Production: postgres://user:pass@your-rds-host:5432/caleo
DATABASE_URL=your-database-connection-string

# --- OAuth: Google Calendar ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- OAuth: Microsoft Outlook ---
MICROSOFT_APP_ID=your-azure-app-id
MICROSOFT_APP_PASSWORD=your-azure-app-secret

# --- OAuth Redirect URI ---
# Must match what's registered in Google Cloud Console and Azure AD
# Local dev: use NGROK_URL/auth/callback
# Production: https://your-domain.com/auth/callback
OAUTH_REDIRECT_URI=
NGROK_URL=

# --- Encryption ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used for: OAuth token encryption, checkout URL signing, OAuth state signing
ENCRYPTION_KEY=generate-a-64-char-hex-key

# --- Stripe Billing ---
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
# Base URL for Stripe redirect URLs (checkout success/cancel pages)
BILLING_BASE_URL=https://your-domain.com

# --- Agent Mode ---
# true = ECS bot calls Lambda for AI processing
# false = ECS bot runs AI locally (needs ANTHROPIC_API_KEY)
USE_REMOTE_AGENT=false
AGENT_ENDPOINT=https://your-api-gateway.execute-api.us-east-1.amazonaws.com/agent

# --- Email Notifications (Operational Alerts) ---
# Leave ADMIN_NOTIFY_EMAIL empty to disable notifications entirely
ADMIN_NOTIFY_EMAIL=
NOTIFY_FROM_EMAIL=caleo-alerts@yourdomain.com
# SES SMTP credentials (from SES console → SMTP settings)
# If not set, falls back to Ethereal test account (no real emails)
SES_SMTP_USER=
SES_SMTP_PASS=
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com

# --- RDS SSL Certificate ---
# Path to the RDS CA bundle for SSL certificate pinning
# Download from: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# In Docker, this is auto-downloaded to /app/rds-combined-ca-bundle.pem
# For local dev, leave unset (SSL verification disabled in non-production)
RDS_CA_CERT_PATH=

# --- Environment ---
NODE_ENV=development
