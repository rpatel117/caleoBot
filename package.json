{
  "name": "caleo-bot",
  "version": "2.0.0",
  "description": "Caleo - Slack-first multi-provider AI calendar assistant",
  "main": "dist/slack/index.js",
  "scripts": {
    "start": "node dist/slack/index.js",
    "dev": "nodemon dist/slack/index.js",
    "build": "tsc",
    "db:init": "psql $DATABASE_URL -f src/database/schema.sql",
    "db:reset": "psql $DATABASE_URL -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:init",
    "ngrok": "npx ngrok http 3000",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --forceExit --detectOpenHandles --coverage"
  },
  "keywords": [
    "slack",
    "calendar",
    "ai-assistant",
    "caleo"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@slack/bolt": "^4.2.1",
    "dotenv": "^16.3.1",
    "googleapis": "^144.0.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.16.3",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.4.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.6",
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.1.6"
  }
}
